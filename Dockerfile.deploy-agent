# Образ деплой-агента (см. scripts/deploy_agent.py) — отдельный, МИНИМАЛЬНЫЙ
# контейнер с доступом к docker.sock хоста, изолированный от контейнера
# бота (у которого такого доступа нет — см. комментарий в
# scripts/deploy_agent.py про поверхность атаки).
FROM python:3.12-slim

# git — для `git pull`; docker.io/docker-compose-v2 — CLI для управления
# СОСЕДНИМИ контейнерами через смонтированный docker.sock хоста (см.
# docker-compose.yml, сервис deploy-agent).
RUN apt-get update \
    && apt-get install -y --no-install-recommends git docker.io docker-compose-v2 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY scripts/deploy_agent.py .

ENV PYTHONUNBUFFERED=1

EXPOSE 8091

CMD ["python", "deploy_agent.py"]
