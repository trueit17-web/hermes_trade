# CryptoBot Pro — автономный самообучающийся крипто-трейдер бот
# Архитектура: event-driven, modular, asyncio + FastAPI + ML + Telegram + CoinGlass

# Структура проекта:
#
# crypto-bot/
# ├── alembic/                  # миграции БД
# │   ├── versions/
# │   └── env.py
# ├── src/
# │   ├── __init__.py
# │   ├── main.py               # точка входа
# │   ├── config.py             # загрузка конфига (Pydantic)
# │   ├── event_bus.py          # asyncio event bus (pub/sub)
# │   ├── db/
# │   │   ├── __init__.py
# │   │   ├── base.py           # SQLAlchemy base
# │   │   ├── models.py         # все модели
# │   │   └── session.py        # сессии
# │   ├── data_ingest/
# │   │   ├── __init__.py
# │   │   ├── market_data.py    # WebSocket с бирж (ccxt.pro)
# │   │   ├── coinglass_client.py  # CoinGlass REST API
# │   │   └── feature_engine.py    # индикаторы, фичи
# │   ├── strategy/
# │   │   ├── __init__.py
# │   │   ├── base.py           # ABC стратегии
# │   │   ├── rsi_strategy.py
# │   │   ├── ema_strategy.py
# │   │   ├── bb_strategy.py
# │   │   ├── funding_strategy.py
# │   │   ├── liquidation_strategy.py
# │   │   ├── ml_classifier_strategy.py
# │   │   └── ensemble_voter.py
# │   ├── risk/
# │   │   ├── __init__.py
# │   │   └── risk_manager.py
# │   ├── execution/
# │   │   ├── __init__.py
# │   │   ├── executor.py       # ордера, ccxt
# │   │   └── paper_engine.py   # paper trading
# │   ├── ml/
# │   │   ├── __init__.py
# │   │   ├── feature_store.py
# │   │   ├── trainer.py        # обучение LightGBM
# │   │   ├── model_registry.py
# │   │   └── inference.py
# │   ├── telegram/
# │   │   ├── __init__.py
# │   │   ├── channel_monitor.py  # телеграм мониторинг
# │   │   ├── signal_parser.py    # regex + LLM парсер
# │   │   └── quality_scorer.py
# │   ├── web/
# │   │   ├── __init__.py
# │   │   ├── api.py            # FastAPI роуты
# │   │   ├── websocket.py      # WebSocket хабы
# │   │   └── schemas.py        # Pydantic схемы
# │   └── utils/
# │       ├── __init__.py
# │       ├── crypto.py         # шифрование API ключей
# │       └── logging.py        # настройка логирования
# ├── tests/
# ├── alembic.ini
# ├── docker-compose.yml
# ├── Dockerfile
# ├── requirements.txt
# ├── .env.example
# └── README.md

Бот полностью автономен, самообучающееся, поддерживает Binance/Bybit, CoinGlass, Telegram сигналы, paper/real режимы, риск-менеджмент, веб-интерфейс.
