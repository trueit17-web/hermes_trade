# Криптобот — настройки по умолчанию
# Скопируйте в .env и настройте

# === Режим работы ===
TRADING_MODE=paper
STARTUP_CAPITAL_USDT=10000
LOG_LEVEL=INFO

# === Биржи ===
BINANCE_API_KEY=
BINANCE_API_SECRET=
BYBIT_API_KEY=
BYBIT_API_SECRET=

# === CoinGlass API ===
COINGLASS_API_KEY=

# === Telegram мониторинг ===
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_USER_ID=

# === Telegram уведомления ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === База данных ===
DATABASE_URL=sqlite+aiosqlite:///./data/cryptobot.db
# Только для docker-compose (сборка DATABASE_URL/POSTGRES_PASSWORD для
# сервиса db) — обязательно смените, иначе Postgres останется на пароле
# "password" по умолчанию.
DB_PASSWORD=changeme

# === Redis ===
REDIS_URL=redis://localhost:6379

# === Шифрование ===
ENCRYPTION_KEY=

# === ML ===
ML_RETRAINING_INTERVAL_HOURS=6
ML_MAX_TRADES_FOR_RETRAIN=200
ML_ACTIVE_MODEL_VERSION=1
ML_OPTUNA_TRIALS=30
ML_OPTUNA_MIN_SAMPLES=150

# === Риск ===
RISK_DAILY_LOSS_LIMIT_USD=500
RISK_MAX_OPEN_POSITIONS=8
RISK_MAX_POSITION_SIZE_PCT=10
RISK_MAX_DRAWDOWN_PCT=15
RISK_COOLDOWN_SECONDS=300

# === CoinGlass ===
COINGLASS_UPDATE_INTERVAL_HOURS=1

# === Telegram сигналы ===
TELEGRAM_SIGNALS_AUTO_EXECUTE=false
TELEGRAM_SIGNALS_QUALITY_THRESHOLD=0.5

# === Торговая вселенная (все активные spot-пары к quote-валюте, кроме блэклиста) ===
SYMBOL_QUOTE_CURRENCY=USDT
# Список в формате JSON, напр.: SYMBOL_BLACKLIST=["USDC/USDT","FDUSD/USDT"]
SYMBOL_BLACKLIST=[]
SYMBOL_UNIVERSE_MAX=30
SYMBOL_UNIVERSE_REFRESH_HOURS=12

# === Аналитика ===
PERFORMANCE_SNAPSHOT_INTERVAL_HOURS=1

# === Веб ===
WEB_HOST=0.0.0.0
WEB_PORT=8000
# Логин/пароль для входа в веб-панель (/dashboard) — ОБЯЗАТЕЛЬНО смените
# пароль по умолчанию перед тем, как открывать порт наружу.
WEB_ADMIN_USERNAME=admin
WEB_ADMIN_PASSWORD=changeme
# true, если панель доступна только по HTTPS (иначе cookie сессии не будет
# помечена Secure, что нормально для localhost/VPN-доступа по HTTP)
WEB_COOKIE_SECURE=false
